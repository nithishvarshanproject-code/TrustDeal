# omega/omega.env - secrets for the Omega agent container. NEVER commit this file.
# omega\start-omega.bat creates omega.env from this template on first run and fills in
# DEALDESK_TOKEN and OMEGACLAW_AUTH_SECRET with random values.
# Only ASIONE_API_KEY has to be typed in by you (for "start-omega.bat agent"); the last two are optional.
# No quotes, no spaces around "=".

# ASI:One API key, used by the agent's own LLM loop (chat). Never used for decisions.
ASIONE_API_KEY=

# Shared secret between the backend and the TrustDeal plugin (dealdesk, generated).
DEALDESK_TOKEN=

# One-time IRC auth code: in the IRC channel, send "auth <this value>" once (generated).
OMEGACLAW_AUTH_SECRET=

# Optional: Tavily web search key for the seller-only market_price_lookup tool.
TAVILY_API_KEY=

# Optional: Telegram bot token from @BotFather (customer chats and seller alerts; README, Telegram).
# Read by the backend only (never passed to the Omega container). Empty = Telegram off.
TELEGRAM_BOT_TOKEN=
